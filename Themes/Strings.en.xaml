<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Lang.File">_File</sys:String>
    <sys:String x:Key="Lang.FileOpen">_Open...</sys:String>
    <sys:String x:Key="Lang.FileReload">_Refresh</sys:String>
    <sys:String x:Key="Lang.FilePrint">_Print...</sys:String>
    <sys:String x:Key="Lang.FileSaveXps">Save _as XPS...</sys:String>
    <sys:String x:Key="Lang.FileExit">E_xit</sys:String>

    <sys:String x:Key="Lang.View">_View</sys:String>
    <sys:String x:Key="Lang.ViewTheme">_Theme</sys:String>
    <sys:String x:Key="Lang.ViewThemeAuto">_Auto</sys:String>
    <sys:String x:Key="Lang.ViewThemeLight">_Light</sys:String>
    <sys:String x:Key="Lang.ViewThemeDark">_Dark</sys:String>
    <sys:String x:Key="Lang.ViewHighlight">_Code highlighting</sys:String>
    <sys:String x:Key="Lang.ViewLanguage">_Language</sys:String>
    <sys:String x:Key="Lang.System">_System default</sys:String>
    <sys:String x:Key="Lang.English">English</sys:String>
    <sys:String x:Key="Lang.Russian">Русский</sys:String>
    <sys:String x:Key="Lang.ViewToc">_Table of contents</sys:String>
    <sys:String x:Key="Lang.ViewZoomIn">Zoom _in</sys:String>
    <sys:String x:Key="Lang.ViewZoomOut">Zoom _out</sys:String>
    <sys:String x:Key="Lang.ViewZoomReset">_Reset zoom</sys:String>

    <sys:String x:Key="Lang.Help">_Help</sys:String>
    <sys:String x:Key="Lang.HelpRepo">Open _GitHub repository</sys:String>
    <sys:String x:Key="Lang.HelpAbout">_About mdview</sys:String>
    <sys:String x:Key="Lang.TocTitle">Table of contents</sys:String>
    <sys:String x:Key="Lang.Copy">Copy</sys:String>
    <sys:String x:Key="Lang.Copied">Copied</sys:String>

    <sys:String x:Key="Msg.OpenError">Could not open the file:</sys:String>
    <sys:String x:Key="Msg.DropUnsupported">Supported files: .md, .markdown, .mdown, .mkd, .txt</sys:String>
    <sys:String x:Key="Msg.UnexpectedError">Unexpected error:</sys:String>
    <sys:String x:Key="Msg.PrintError">Could not print:</sys:String>
    <sys:String x:Key="Msg.XpsError">Could not save XPS:</sys:String>
    <sys:String x:Key="Msg.XpsTitle">Save as XPS</sys:String>
    <sys:String x:Key="Msg.XpsFilter">XPS document (*.xps)|*.xps</sys:String>
    <sys:String x:Key="Msg.DefaultDocName">document</sys:String>
    <sys:String x:Key="Msg.FilterMd">Markdown (*.md;*.markdown;*.mdown;*.mkd)|*.md;*.markdown;*.mdown;*.mkd</sys:String>
    <sys:String x:Key="Msg.FilterTxt">Text files (*.txt)|*.txt</sys:String>
    <sys:String x:Key="Msg.FilterAll">All files (*.*)|*.*</sys:String>

    <sys:String x:Key="Welcome.Lead">Lightweight Markdown viewer. Open a file:</sys:String>
    <sys:String x:Key="Welcome.HintDialog">Ctrl+O — open dialog</sys:String>
    <sys:String x:Key="Welcome.HintDrop">drag &amp; drop a .md file into the window</sys:String>
    <sys:String x:Key="Welcome.HintCli">or run: mdview.exe readme.md</sys:String>
    <sys:String x:Key="Welcome.Hints">Ctrl+T — table of contents, F5 — refresh, Ctrl+mouse wheel — zoom. Print — Ctrl+P. Dark theme — in the "View" menu.</sys:String>

    <sys:String x:Key="About.Title">About mdview</sys:String>
    <sys:String x:Key="About.Tagline">Lightweight Markdown viewer for Windows (.NET 8 + WPF FlowDocument)</sys:String>
    <sys:String x:Key="About.Version">Version</sys:String>
    <sys:String x:Key="About.Repo">Source code on GitHub</sys:String>
</ResourceDictionary>
