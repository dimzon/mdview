<Window x:Class="MdView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MdView"
        Title="mdview" Width="1000" Height="720" MinWidth="560" MinHeight="380"
        Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{x:Static local:MainWindow.ToggleTocCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{x:Static local:MainWindow.ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{x:Static local:MainWindow.ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{x:Static local:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{x:Static local:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{x:Static local:MainWindow.ZoomResetCommand}"/>
        <KeyBinding Modifiers="Control" Key="P" Command="{x:Static local:MainWindow.PrintCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static local:MainWindow.SaveXpsCommand}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpenExecuted"/>
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="OnReloadExecuted"/>
        <CommandBinding Command="{x:Static local:MainWindow.ToggleTocCommand}" Executed="OnToggleTocExecuted"/>
        <CommandBinding Command="{x:Static local:MainWindow.ZoomInCommand}" Executed="OnZoomIn"/>
        <CommandBinding Command="{x:Static local:MainWindow.ZoomOutCommand}" Executed="OnZoomOut"/>
        <CommandBinding Command="{x:Static local:MainWindow.ZoomResetCommand}" Executed="OnZoomReset"/>
        <CommandBinding Command="{x:Static local:MainWindow.PrintCommand}" Executed="OnPrintExecuted"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveXpsCommand}" Executed="OnSaveXpsExecuted"/>
    </Window.CommandBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource MenuBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{DynamicResource FgBrush}">
                <MenuItem Header="{DynamicResource Lang.File}">
                    <MenuItem Header="{DynamicResource Lang.FileOpen}" Command="{x:Static ApplicationCommands.Open}"/>
                    <MenuItem Header="{DynamicResource Lang.FileReload}" Command="{x:Static NavigationCommands.Refresh}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Lang.FilePrint}" InputGestureText="Ctrl+P" Command="{x:Static local:MainWindow.PrintCommand}"/>
                    <MenuItem Header="{DynamicResource Lang.FileSaveXps}" InputGestureText="Ctrl+S" Command="{x:Static local:MainWindow.SaveXpsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Lang.FileExit}" InputGestureText="Alt+F4" Click="OnExitClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Lang.View}">
                    <MenuItem Header="{DynamicResource Lang.ViewTheme}">
                        <MenuItem x:Name="AutoThemeItem" Header="{DynamicResource Lang.ViewThemeAuto}" IsCheckable="True" Click="OnThemeClick"/>
                        <MenuItem x:Name="LightThemeItem" Header="{DynamicResource Lang.ViewThemeLight}" IsCheckable="True" Click="OnThemeClick"/>
                        <MenuItem x:Name="DarkThemeItem" Header="{DynamicResource Lang.ViewThemeDark}" IsCheckable="True" Click="OnThemeClick"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Lang.ViewLanguage}">
                        <MenuItem x:Name="SystemLangItem" Header="{DynamicResource Lang.System}" IsCheckable="True" Click="OnLanguageClick"/>
                        <MenuItem x:Name="EnglishItem" Header="{DynamicResource Lang.English}" IsCheckable="True" Click="OnLanguageClick"/>
                        <MenuItem x:Name="RussianItem" Header="{DynamicResource Lang.Russian}" IsCheckable="True" Click="OnLanguageClick"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Lang.ViewToc}" InputGestureText="Ctrl+T" Command="{x:Static local:MainWindow.ToggleTocCommand}"/>
                    <MenuItem Header="{DynamicResource Lang.ViewZoomIn}" InputGestureText="Ctrl +" Command="{x:Static local:MainWindow.ZoomInCommand}"/>
                    <MenuItem Header="{DynamicResource Lang.ViewZoomOut}" InputGestureText="Ctrl −" Command="{x:Static local:MainWindow.ZoomOutCommand}"/>
                    <MenuItem Header="{DynamicResource Lang.ViewZoomReset}" InputGestureText="Ctrl 0" Command="{x:Static local:MainWindow.ZoomResetCommand}"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Lang.Help}">
                    <MenuItem Header="{DynamicResource Lang.HelpRepo}" Click="OnOpenRepoClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Lang.HelpAbout}" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TocPanel" Width="240" Visibility="Collapsed"
                    Background="{DynamicResource TocBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Lang.TocTitle}" FontWeight="Bold" Padding="12,10,12,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TocList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               ToolTip="{Binding Text}"
                                               Margin="{Binding Indent}"
                                               Padding="12,4"
                                               TextTrimming="CharacterEllipsis"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="OnTocItemClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <FlowDocumentScrollViewer x:Name="Viewer" Grid.Column="1" Background="{DynamicResource BgBrush}"/>
        </Grid>
    </DockPanel>
</Window>
